# Version-control and local-agent state
.git
.jj
.agents
.claude/.local
.pi/outputs

# Non-workspace directories the worker never needs. The install uses
# `--filter ai-editing-worker`, but bun still validates the full workspace
# manifest, so apps/, packages/ (the 4 workspace packages), and services/ (the
# 4 workspace services) must remain. Everything else — Rust crates, docker/
# Dockerfiles, infra, tooling, docs — is trimmed from the context.
/crates
/docker
/infra
/tooling
/docs
/.github
/nix
/.cargo
/scripts
/packages/sdk

# Secrets and local configuration
.env
.env.*
**/.env
**/.env.*
**/*.env
**/*.env.*
**/.dev.vars*

# Dependency and generated output
**/node_modules
**/target
**/dist
**/build
**/.wrangler
**/test-results
**/playwright-report
**/coverage
**/.cache
**/.vite
**/*.tsbuildinfo
**/*.log

# Editor and operating-system noise
**/.DS_Store
**/.idea
**/.vscode
**/*.swp
**/*.swo
