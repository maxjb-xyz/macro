# Self-host single-origin reverse proxy (Caddy).
#
# This is the operator-owned equivalent of the generated xtask Caddyfile. It
# serves the built frontend SPA and routes API paths to the backend services
# using the same path prefixes and service names/aliases the local stack uses.
# Keep route prefixes in sync with tooling/xtask/.../inventory.rs.

{
    auto_https off
    admin off
}

:80 {
    # ---- Rust service routes (from inventory path_prefix) ----
    handle_path /auth/* {
        reverse_proxy authentication-service:8080
    }
    @connection_gateway path /connection-gateway /connection-gateway/*
    handle @connection_gateway {
        uri strip_prefix /connection-gateway
        reverse_proxy connection_gateway:8080
    }
    handle_path /contacts/* {
        reverse_proxy contacts_service:8080
    }
    handle_path /cognition/* {
        reverse_proxy document_cognition_service:8080
    }
    handle_path /dss/* {
        reverse_proxy document_storage_service:8080
    }
    handle_path /email/* {
        reverse_proxy email_service:8080
    }
    handle_path /notification/* {
        reverse_proxy notification_service:8080
    }
    handle_path /unfurl/* {
        reverse_proxy unfurl_service:8080
    }
    handle_path /image-proxy/* {
        reverse_proxy image_proxy_service:8080
    }

    # ---- Worker / non-inventory service routes ----
    @websocket path /websocket /websocket/*
    handle @websocket {
        uri strip_prefix /websocket
        reverse_proxy websocket-service:6969
    }
    @sync path /sync /sync/*
    handle @sync {
        uri strip_prefix /sync
        reverse_proxy sync-service:8787
    }
    handle /i/* {
        reverse_proxy analytics-proxy:8098 {
            header_up CF-Connecting-IP {http.request.remote.host}
        }
    }
    handle_path /lexical/* {
        reverse_proxy lexical-service:8096
    }
    handle_path /ai-editing/* {
        reverse_proxy ai-editing-worker:8933
    }

    # ---- Mailpit (passwordless login codes) ----
    handle /mailpit/* {
        reverse_proxy mailpit:8025
    }
    redir /mailpit /mailpit/ 308

    # ---- Static file CDN (S3 via LocalStack) ----
    route /static-file/* {
        uri strip_prefix /static-file
        @svc path /api/* /internal/*
        reverse_proxy @svc static_file_service:8080
        rewrite * /static-file-storage{uri}
        reverse_proxy localstack:4566
    }

    # ---- Frontend SPA (built at /app base) ----
    redir / /app/?{query} 302
    redir /app /app/ 308
    handle_path /app/* {
        root * /srv/frontend
        try_files {path} /index.html
        file_server
    }

    respond "macro self-host proxy" 200
}
