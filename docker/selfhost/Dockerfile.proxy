# Self-host frontend + reverse proxy image.
#
# Two stages:
#   1. frontend-builder — bun + vite build of apps/web with
#      VITE_LOCAL_BACKEND_ORIGIN=same-origin (the proxy origin).
#   2. caddy           — serve the dist bundle under /app and reverse-proxy API
#                        paths via docker/selfhost/Caddyfile.
#
# NOTE: the GraphQL cache WASM package (crates/client/cache-wasm) is NOT built
# here. It is loaded dynamically at runtime (`@vite-ignore`), so the frontend
# builds without it and the normalized cache degrades to network-only — an
# acceptable MVP tradeoff. Operators who want the full cache should build it
# with `just build-cache-wasm` before the image build and place it at
# apps/web/src/lib/graphql-cache/wasm/.
#
# Build context must be the repository root.

# ---- Stage 1: frontend build ----
FROM oven/bun:1 AS frontend-builder
WORKDIR /app
COPY package.json bun.lock ./
COPY apps/web/package.json apps/web/
COPY packages/ packages/
COPY static_assets/ static_assets/
RUN cd apps/web && bun install --frozen-lockfile
COPY apps/web/ apps/web/
WORKDIR /app/apps/web
ENV CI=true \
    MODE=development \
    NODE_ENV=production \
    NODE_OPTIONS=--max-old-space-size=6144 \
    VITE_LOCAL_BACKEND_ORIGIN=same-origin
RUN bun run --bun build

# ---- Stage 2: Caddy + static frontend ----
FROM caddy:2-alpine
COPY docker/selfhost/Caddyfile /etc/caddy/Caddyfile
COPY --from=frontend-builder /app/apps/web/dist /srv/frontend
EXPOSE 80
