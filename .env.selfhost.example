# Production-ish self-host environment contract for Macro.
#
# Copy to an operator-owned file before use:
#   cp .env.selfhost.example .env.selfhost
#   $EDITOR .env.selfhost
#
# This file is safe to commit: every secret is a placeholder. Replace every
# CHANGEME_* value before exposing a deployment to users. Empty optional
# integration values mean the feature is not configured; see
# docs/selfhost/env-contract.md for the disabled/stubbed policy.

# -----------------------------------------------------------------------------
# 1. Compose/env-file plumbing — local defaults
# -----------------------------------------------------------------------------
# Two files matter to Compose: ${VAR} substitutions (SELF_HOST_DOMAIN,
# MACRO_RELEASE_IMAGE_*) are read from the file passed with `--env-file` (or the
# auto-loaded `.env`), while MACRO_ENV_FILE below is what gets injected into
# every container's environment. Point --env-file and MACRO_ENV_FILE at the same
# operator-owned file (e.g. `--env-file .env.selfhost`) to avoid drift.
MACRO_ENV_FILE=.env.selfhost
# compose.yml is the full production stack (base + self-host proxy/storage +
# release images + hardening). A bare `docker compose up -d` needs no
# COMPOSE_FILE or -f flags.
ENVIRONMENT=selfhost
PORT=8080
# Vestigial for self-host: the frontend is served at /app/ by the proxy, not on
# a separate dev server. Kept only because local-dev code paths reference it.
FRONTEND_PORT=3000
KAFKA_TOPIC_PARTITIONS=1

# Release-image source (compose.yml pins every Macro service to these images).
# The fork's CI publishes publicly to GHCR on each release (`v*` tag) or manual
# dispatch. Pin
# MACRO_RELEASE_IMAGE_TAG to a `sha-<full-sha>` (or a `v*` tag) for
# reproducible deploys instead of `latest`.
MACRO_RELEASE_IMAGE_REGISTRY=ghcr.io/maxjb-xyz/macro
MACRO_RELEASE_IMAGE_TAG=latest

# -----------------------------------------------------------------------------
# 2. Public deployment identity — public URLs
# -----------------------------------------------------------------------------
# BASE_URL and FUSIONAUTH_OAUTH_REDIRECT_URI must be the PUBLIC origin users
# actually reach (not a Compose hostname). The `fusionauth_sync_config` one-shot
# service PATCHes these into FusionAuth's authorized OAuth redirect URLs on every
# boot — without them, passwordless login is rejected (the kickstart only
# authorizes localhost origins) and the "continue" step fails silently.
BASE_URL=https://macro.example.com
# Optional: document-sync websocket CORS allowlist. Defaults to BASE_URL when
# unset. Comma-separate multiple origins if the app is also served from another
# domain (e.g. a preview/vanity domain).
#SYNC_ALLOWED_ORIGINS=https://macro.example.com,https://alt.example.com
# Caddy site address for the frontend/API edge. Empty/unset = plain HTTP on
# localhost. Set to your real domain (e.g. https://macro.example.com) to enable
# automatic Let's Encrypt HTTPS on port 443 with an HTTP->HTTPS redirect.
# (Behind a Cloudflare Tunnel, use the http:// scheme here and point the tunnel
# at the proxy's HTTP port — Cloudflare terminates TLS at the edge.)
SELF_HOST_DOMAIN=https://macro.example.com
# Proxy host ports. Defaults are 80/443 (direct Let's Encrypt). Behind a
# Cloudflare Tunnel, publish HTTP on a custom port (e.g. 8054) and point the
# tunnel at it; PROXY_HTTPS_PORT is then unused (Cloudflare terminates TLS), so
# set it to an unused port or leave it as-is if 443 is free.
#PROXY_HTTP_PORT=8054
#PROXY_HTTPS_PORT=443
# Public URL where FusionAuth is reachable from the browser (SSO login/logout).
# This is a SEPARATE host (the `auth.` subdomain) routed to FusionAuth's
# published port 9011 — e.g. a Cloudflare Tunnel route `auth.example.com` ->
# `http://localhost:9011`. Without this, Google/GitHub SSO and logout redirect
# to the internal http://fusionauth:9011 / localhost and fail for remote users.
FUSIONAUTH_PUBLIC_URL=https://auth.macro.example.com
FUSIONAUTH_OAUTH_REDIRECT_URI=https://macro.example.com/oauth/redirect
# ISSUER is the FusionAuth *tenant issuer*, baked into kickstart.json as
# "local.macro.com". The backend validates the JWT `iss` claim against this, so
# it must stay exactly that value — otherwise every authenticated request 401s
# (create team, enable CRM, set profile pic, etc. all fail).
ISSUER=local.macro.com
AUDIENCE=22222222-2222-4222-8222-222222222222
SENDER_BASE_ADDRESS=macro.example.com

# -----------------------------------------------------------------------------
# 3. Core data services — local defaults unless operator externalizes them
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGEME_FUSIONAUTH_POSTGRES_ROOT_PASSWORD
DATABASE_USER=fusionauth
DATABASE_URL=postgres://macro:CHANGEME_MACRO_DB_PASSWORD@postgres:5432/macrodb
DATABASE_URL_READONLY=postgres://macro_ro:CHANGEME_MACRO_DB_READONLY_PASSWORD@postgres:5432/macrodb
MACRO_DB_URL=postgres://macro:CHANGEME_MACRO_DB_PASSWORD@postgres:5432/macrodb
REDIS_URI=redis://redis:6379
REDIS_HOST=redis://redis:6379
LAST_ONLINE_REDIS_URI=redis://redis:6379
DOCUMENT_STORAGE_SERVICE_REDIS_URI=redis://redis:6379
KAFKA_BROKERS=kafka:29092
OPENSEARCH_URL=http://search:9200
OPENSEARCH_USERNAME=CHANGEME_OPENSEARCH_USERNAME
OPENSEARCH_PASSWORD=CHANGEME_OPENSEARCH_PASSWORD

# -----------------------------------------------------------------------------
# 4. Object storage, queues, and tables — LocalStack defaults
# -----------------------------------------------------------------------------
# Self-host runs a durable LocalStack (S3/SQS/DynamoDB) by default. The values
# below are the DETERMINISTIC names LocalStack provisions at boot
# (docker/localstack/init/ready.d/001-macro-resources.sh) and the code-owned
# catalog (tooling/xtask/crates/xtask_local/src/local/resources.rs). They must
# match, or services point at buckets/queues/tables that don't exist.
#
# LOCAL_AWS_URL must be SET to the LocalStack endpoint. When set, the S3/SQS
# clients use LocalStack test credentials + path-style addressing. An EMPTY
# value is NOT "real AWS": the AWS SDK then loads an empty endpoint and every
# object-store call (PFP upload, document upload, attachments) fails. To use
# real AWS, remove the variable entirely (not empty) and supply real creds +
# your own bucket/table/queue names.
LOCAL_AWS_URL=http://localstack:4566
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Public origin for browser-facing S3 presigned URLs (PFP upload, document
# upload, attachments). When set, presigned URLs are rewritten to
# {S3_PUBLIC_BASE_URL}/s3/{bucket}/{key}, which the proxy routes back to
# LocalStack — required for remote browsers (localhost:4566 only resolves on
# the host itself). Set it to your public origin (same as BASE_URL).
S3_PUBLIC_BASE_URL=https://macro.example.com

# S3 buckets (LocalStack-provisioned names)
ATTACHMENT_BUCKET=macro-email-attachments
DOCUMENT_STORAGE_BUCKET=doc-storage
DOCX_DOCUMENT_UPLOAD_BUCKET=docx-upload
STATIC_STORAGE_BUCKET=static-file-storage
UPLOAD_STAGING_BUCKET=bulk-upload-staging
CALL_RECORDING_BUCKET_NAME=macro-call-recording-local

# DynamoDB tables (LocalStack-provisioned names). BACKFILL_JOBS_TABLE is
# self-created by search_processing_service on startup in Local.
BACKFILL_JOBS_TABLE=search-processing-backfill-jobs
BULK_UPLOAD_REQUESTS_TABLE=bulk-upload
CONNECTION_GATEWAY_TABLE=connection-gateway-table
STATIC_FILE_SERVICE_DYNAMODB_TABLE_NAME=static-file-metadata

# SQS queues. Most services resolve their queue from a code-owned bare-name
# default in macro_queues that matches the LocalStack-provisioned name, so do
# NOT set their OVERRIDE_* vars. Only these take an explicit full-URL override:
OVERRIDE_WEBHOOK_EVENT_QUEUE=http://localstack:4566/000000000000/webhook-event-queue.fifo
OVERRIDE_EMAIL_CRM_CLEANUP_QUEUE=http://localstack:4566/000000000000/email-service-crm-cleanup-queue
OVERRIDE_REMINDER_DISPATCH_QUEUE=http://localstack:4566/000000000000/reminder-dispatch-queue
OVERRIDE_CALENDAR_REMINDER_DISPATCH_QUEUE=http://localstack:4566/000000000000/calendar-reminder-dispatch-queue
DOCUMENT_UPLOAD_FINALIZER_QUEUE_URL=http://localstack:4566/000000000000/document-upload-finalizer-queue
ENABLE_EMAIL_SCHEDULED_QUEUE=true
ENABLE_GMAIL_OPS_QUEUE=true

# -----------------------------------------------------------------------------
# 5. Internal service secrets — internal secret
# -----------------------------------------------------------------------------
INTERNAL_API_SECRET_KEY=CHANGEME_RANDOM_32_BYTES_SHARED_INTERNAL_AUTH
INTERNAL_API_KEY=CHANGEME_RANDOM_32_BYTES_SHARED_INTERNAL_AUTH
INTERNAL_AUTH_KEY=CHANGEME_RANDOM_32_BYTES_SHARED_INTERNAL_AUTH
AUTHENTICATION_SERVICE_SECRET_KEY=CHANGEME_RANDOM_32_BYTES_AUTH_SERVICE_INTERNAL
SYNC_SERVICE_AUTH_KEY=CHANGEME_RANDOM_32_BYTES_SYNC_SERVICE_AUTH
DOCUMENT_PERMISSION_JWT=CHANGEME_RANDOM_32_BYTES_DOCUMENT_PERMISSION_JWT
DOCUMENT_STORAGE_SERVICE_AUTH_KEY=CHANGEME_RANDOM_32_BYTES_DOCUMENT_STORAGE_AUTH
SERVICE_INTERNAL_AUTH_KEY=CHANGEME_RANDOM_32_BYTES_DOCUMENT_STORAGE_AUTH
INTERNAL_CALL_SECRET=CHANGEME_RANDOM_32_BYTES_INTERNAL_CALL_SECRET
URL_SIGNING_HMAC=CHANGEME_RANDOM_32_BYTES_URL_SIGNING_HMAC
JWT_SECRET_KEY=CHANGEME_RANDOM_64_BYTES_FUSIONAUTH_JWT_SIGNING_SECRET

# -----------------------------------------------------------------------------
# 6. Compose-internal service URLs — local defaults
# -----------------------------------------------------------------------------
OVERRIDE_AUTH_SERVICE_URL=http://authentication-service:8080
OVERRIDE_CONNECTION_GATEWAY_URL=http://connection-gateway:8080
OVERRIDE_DOCUMENT_STORAGE_SERVICE_URL=http://document-storage-service:8080
OVERRIDE_EMAIL_SERVICE_URL=http://email-service:8080
OVERRIDE_LEXICAL_SERVICE_URL=http://lexical-service:8096
OVERRIDE_STATIC_FILE_SERVICE_URL=http://static-file-cdn
OVERRIDE_SYNC_SERVICE_URL=http://sync-service:8787
OVERRIDE_AI_EDITING_WORKER_URL=http://ai-editing-worker:8933

# -----------------------------------------------------------------------------
# 7. FusionAuth bootstrap — deterministic IDs + operator secrets
# -----------------------------------------------------------------------------
# FUSIONAUTH_CLIENT_ID, FUSIONAUTH_TENANT_ID and AUDIENCE are NOT secrets: they
# are the deterministic UUIDs baked into infra/stacks/fusionauth-instance/
# kickstart/kickstart.json. They must stay exactly these values, or the auth
# service, kickstart, and the fusionauth_sync_config one-shot will disagree on
# which application/tenant to talk to (passwordless login then fails).
#
# FUSIONAUTH_API_KEY and FUSIONAUTH_API_KEY_SECRET_KEY must hold the SAME value
# (the FusionAuth API key): the auth service reads *_SECRET_KEY, while kickstart
# and the sync one-shot read the bare FUSIONAUTH_API_KEY. Kickstart creates the
# key from FUSIONAUTH_API_KEY on FIRST boot only — once the FusionAuth volume
# exists, changing it here has no effect and the sync will fail with HTTP 401.
# To rotate: reset the FusionAuth volume (loses users) or rotate via the admin
# UI, then update both variables together.
FUSIONAUTH_BASE_URL=http://fusionauth:9011
FUSIONAUTH_API_KEY_SECRET_KEY=CHANGEME_FUSIONAUTH_API_KEY
FUSIONAUTH_API_KEY=CHANGEME_FUSIONAUTH_API_KEY
FUSIONAUTH_CLIENT_ID=22222222-2222-4222-8222-222222222222
FUSIONAUTH_TENANT_ID=11111111-1111-4111-8111-111111111111
FUSIONAUTH_CLIENT_SECRET_KEY=CHANGEME_FUSIONAUTH_CLIENT_SECRET
FUSIONAUTH_ADMIN_EMAIL=admin@macro.com
FUSIONAUTH_ADMIN_PASSWORD=CHANGEME_FUSIONAUTH_ADMIN_PASSWORD

# -----------------------------------------------------------------------------
# 8. Email delivery — integration key + public sender identity
# -----------------------------------------------------------------------------
SMTP_HOST=CHANGEME_SMTP_HOST
SMTP_PORT=587
SMTP_USERNAME=CHANGEME_SMTP_USERNAME
SMTP_PASSWORD_SECRET_KEY=CHANGEME_SMTP_PASSWORD

# -----------------------------------------------------------------------------
# 9. Signed URL / CDN compatibility — external-required or stubbed by policy
# -----------------------------------------------------------------------------
DOCUMENT_STORAGE_SERVICE_CLOUDFRONT_DISTRIBUTION_URL=https://files.macro.example.com
DOCUMENT_STORAGE_SERVICE_CLOUDFRONT_SIGNER_PUBLIC_KEY_ID=CHANGEME_DOCUMENT_CDN_SIGNER_PUBLIC_KEY_ID
DOCUMENT_STORAGE_SERVICE_CLOUDFRONT_SIGNER_PRIVATE_KEY=CHANGEME_DOCUMENT_CDN_SIGNER_PRIVATE_KEY
DOCUMENT_STORAGE_SERVICE_CLOUDFRONT_SIGNER_PRIVATE_KEY_SECRET_NAME=CHANGEME_DOCUMENT_CDN_SIGNER_PRIVATE_KEY_SECRET_NAME
EMAIL_SERVICE_CLOUDFRONT_DISTRIBUTION_URL=https://email-files.macro.example.com
EMAIL_SERVICE_CLOUDFRONT_SIGNER_PUBLIC_KEY_ID=CHANGEME_EMAIL_CDN_SIGNER_PUBLIC_KEY_ID
EMAIL_SERVICE_CLOUDFRONT_SIGNER_PRIVATE_KEY=CHANGEME_EMAIL_CDN_SIGNER_PRIVATE_KEY

# -----------------------------------------------------------------------------
# 10. Optional/external integrations — integration key or disabled feature
# -----------------------------------------------------------------------------
# Do not delete these keys. Configure real provider credentials or keep the
# feature disabled/stubbed according to docs/selfhost/env-contract.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_IDP_ID=
GITHUB_SYNC_APP_URL=https://macro.example.com
GITHUB_SYNC_APP_CLIENT_ID=
GITHUB_SYNC_APP_CLIENT_SECRET=
GITHUB_INSTALLATION_STATE_SECRET=
GITHUB_WEBHOOK_SECRET_KEY=
GITHUB_SYNC_APP_PEM_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET_KEY=
GMAIL_GCP_QUEUE=
APOLLO_API_KEY=
APPLE_BUNDLE_ID=
SNS_FCM_PLATFORM_ARN=
SNS_APNS_PLATFORM_ARN=
MCP_CREDENTIALS_KEY_SECRET_NAME=CHANGEME_BASE64_32_BYTE_MCP_CREDENTIALS_AES_KEY
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
COHERE_API_KEY=
CEREBRAS_API_KEY=
SLACK_MCP_CLIENT_ID=
SLACK_MCP_CLIENT_SECRET=
LIVEKIT_SERVER_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
CAL_WEBHOOK_SECRET_KEY=
CAL_EVENT_TYPE_CONTENT_NAMES_KEY=
META_PIXEL_ID=
META_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# 11. Feature policy flags currently supported by code — local default
# -----------------------------------------------------------------------------
# Unlock every paywalled feature (premium features + professional AI models)
# without a Stripe subscription. Self-host operators ARE the provider, so the
# billing wall is lifted: every user gets professional permissions and the
# premium extractor passes. Set false only if you run your own Stripe billing.
SELF_HOST_UNLOCK_ALL=true
CALENDAR_SYNC_ENABLED=false
CALENDAR_SCOPE_ENABLED=false

# -----------------------------------------------------------------------------
# 12. Macro API token signing — internal RSA keypair
# -----------------------------------------------------------------------------
# MACRO_API_TOKEN_PRIVATE_SECRET_KEY (RSA PRIVATE KEY) and
# MACRO_API_TOKEN_PUBLIC_KEY (RSA PUBLIC KEY) must be a matching keypair. They
# are NOT the CHANGEME placeholders — generate them with:
#   tooling/selfhost/generate-secrets.sh          (fresh .env)
#   tooling/selfhost/fix-macro-api-token-key.sh   (existing .env)
# Both write the PEM single-line with literal `\n`; the app normalizes it back.
# A placeholder here makes /jwt/macro_api_token 500 ("failed to create encoding
# key"), which breaks document/entity operations that rely on the macro-api-token.
MACRO_API_TOKEN_ISSUER=https://macro.example.com
MACRO_API_TOKEN_PUBLIC_KEY=CHANGEME_MACRO_API_TOKEN_PUBLIC_KEY
MACRO_API_TOKEN_PRIVATE_SECRET_KEY=CHANGEME_MACRO_API_TOKEN_PRIVATE_KEY
MACRO_API_TOKEN_EXPIRY_SECONDS=3600

# -----------------------------------------------------------------------------
# 13. Integration graceful-degradation flags
# -----------------------------------------------------------------------------
# An integration is "configured" only when its *_ENABLED flag is true AND its
# credentials are real (non-blank, not a `local-*`/`CHANGEME_*` placeholder).
# Self-host ships dummy `local-*` credentials, so Google/GitHub/Stripe degrade
# cleanly — endpoints return a "not configured" response and the web UI hides
# the button — until an operator supplies real OAuth/API credentials.
#
# Gmail sync has no placeholder-detectable credential in the email service, so
# it needs this explicit switch: off by default in self-host.
GMAIL_SYNC_ENABLED=false
# Optional hard-off switches (default true; set false to force-disable even when
# real credentials are present):
GOOGLE_LOGIN_ENABLED=true
GITHUB_LOGIN_ENABLED=true
STRIPE_BILLING_ENABLED=true

# -----------------------------------------------------------------------------
# 14. Identity-provider auto-provisioning
# -----------------------------------------------------------------------------
# When real OAuth credentials are set, the `fusionauth_provision_idps` one-shot
# service creates the matching FusionAuth identity providers automatically
# (config-gated + idempotent; re-run with `docker compose ... run --rm
# fusionauth_provision_idps`). Google/Microsoft IdPs are looked up by name, so
# their Ids are internal. GitHub is looked up by Id, so the IdP is created with
# the value of GITHUB_IDP_ID below — set it to any UUID (or leave the default).
