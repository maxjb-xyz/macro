# Disposable self-host Phase 1 defaults.
# Copy this file to .env before starting the stack:
#   cp .env.example .env
# These values are local-only placeholders. Do not use them for production.

# Compose uses this path for every included service's env_file. Keep it as .env
# for the normal `cp .env.example .env` workflow; the smoke script overrides it
# when it falls back to this example or receives --env-file.
MACRO_ENV_FILE=.env

ENVIRONMENT=local
PORT=8080
FRONTEND_PORT=3000
CALENDAR_SYNC_ENABLED=true
CALENDAR_SCOPE_ENABLED=true

DATABASE_URL=postgres://user:password@postgres:5432/macrodb
DATABASE_URL_READONLY=postgres://user:password@postgres:5432/macrodb
MACRO_DB_URL=postgres://user:password@postgres:5432/macrodb
REDIS_URI=redis://redis:6379
REDIS_HOST=redis://redis:6379
LAST_ONLINE_REDIS_URI=redis://redis:6379
DOCUMENT_STORAGE_SERVICE_REDIS_URI=redis://redis:6379
OPENSEARCH_URL=http://search:9200
OPENSEARCH_USERNAME=macrouser
OPENSEARCH_PASSWORD=local
KAFKA_BROKERS=kafka:29092

# Optional only for private GitHub package dependencies used by the lexical
# service image. Leave empty when the packages are public.
GITHUB_PACKAGES_TOKEN=

LOCAL_AWS_URL=http://localstack:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
DOCUMENT_STORAGE_BUCKET=documents
BACKFILL_JOBS_TABLE=search-processing-backfill-jobs
DOCUMENT_UPLOAD_FINALIZER_QUEUE_URL=http://localstack:4566/000000000000/document-upload-finalizer-queue

# The same local key is shared by the service containers and FusionAuth hooks.
INTERNAL_API_SECRET_KEY=local
INTERNAL_API_KEY=local
INTERNAL_AUTH_KEY=local
SYNC_SERVICE_AUTH_KEY=local
DOCUMENT_PERMISSION_JWT=local
DOCUMENT_STORAGE_SERVICE_AUTH_KEY=local-self-host-dss
SERVICE_INTERNAL_AUTH_KEY=local-self-host-dss

BASE_URL=http://localhost:8080
FUSIONAUTH_BASE_URL=http://fusionauth:9011
FUSIONAUTH_PUBLIC_URL=http://localhost:9011
FUSIONAUTH_API_KEY_SECRET_KEY=bf69486b-4733-4954-a44e-2e1b5f2c8a91
FUSIONAUTH_API_KEY=bf69486b-4733-4954-a44e-2e1b5f2c8a91
FUSIONAUTH_CLIENT_ID=22222222-2222-4222-8222-222222222222
FUSIONAUTH_CLIENT_SECRET_KEY=c3VwZXItc2VjcmV0LWxvY2FsLWNsaWVudC1zZWNyZXQtMDE
FUSIONAUTH_OAUTH_REDIRECT_URI=http://localhost:8080/oauth/redirect
AUDIENCE=22222222-2222-4222-8222-222222222222
ISSUER=local.macro.com
JWT_SECRET_KEY=super-secret-jwt-signing-key-for-local-development-only

SMTP_HOST=mailpit
SMTP_PORT=1025
SENDER_BASE_ADDRESS=macro.local

# Required config-loader stubs. These integrations remain disabled locally.
GOOGLE_CLIENT_ID=local-google-client
GOOGLE_CLIENT_SECRET_KEY=local-google-client-secret
GITHUB_CLIENT_ID=local-github-client
GITHUB_CLIENT_SECRET=local-github-client-secret
GITHUB_IDP_ID=99999999-9999-4999-8999-999999999999
STRIPE_SECRET_KEY=local-stripe-secret
STRIPE_PRICE_ID=local-stripe-price
STRIPE_WEBHOOK_SECRET_KEY=local-stripe-webhook-secret
GMAIL_GCP_QUEUE=gmail-gcp-queue-local
APOLLO_API_KEY=local
APPLE_BUNDLE_ID=com.macro.local

DOCUMENT_STORAGE_SERVICE_CLOUDFRONT_DISTRIBUTION_URL=http://localhost:8100
DOCUMENT_STORAGE_SERVICE_CLOUDFRONT_SIGNER_PUBLIC_KEY_ID=local-cloudfront-signer
DOCUMENT_STORAGE_SERVICE_CLOUDFRONT_SIGNER_PRIVATE_KEY=local
DOCUMENT_STORAGE_SERVICE_CLOUDFRONT_SIGNER_PRIVATE_KEY_SECRET_NAME=local-cloudfront-signer-private-key
EMAIL_SERVICE_CLOUDFRONT_DISTRIBUTION_URL=http://localhost:8100
EMAIL_SERVICE_CLOUDFRONT_SIGNER_PUBLIC_KEY_ID=local-cloudfront-signer
EMAIL_SERVICE_CLOUDFRONT_SIGNER_PRIVATE_KEY=local
MACRO_API_TOKEN_ISSUER=local
MACRO_API_TOKEN_PUBLIC_KEY=local-macro-api-token-public-key
MACRO_API_TOKEN_PRIVATE_SECRET_KEY=local-macro-api-token-private-key
MACRO_API_TOKEN_EXPIRY_SECONDS=3600
SNS_APNS_PLATFORM_ARN=arn:aws:sns:us-east-1:000000000000:app/APNS/macro-local
