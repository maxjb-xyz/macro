# Disposable self-host Phase 1 defaults.
# Copy this file to .env before starting the stack:
#   cp .env.example .env
# These values are local-only placeholders. Do not use them for production.

# Compose uses this path for every included service's env_file. Keep it as .env
# for the normal `cp .env.example .env` workflow; the smoke script overrides it
# when it falls back to this example or receives --env-file.
MACRO_ENV_FILE=.env

ENVIRONMENT=local
PORT=8080
FRONTEND_PORT=3000
CALENDAR_SYNC_ENABLED=true
CALENDAR_SCOPE_ENABLED=true

DATABASE_URL=postgres://user:password@postgres:5432/macrodb
DATABASE_URL_READONLY=postgres://user:password@postgres:5432/macrodb
MACRO_DB_URL=postgres://user:password@postgres:5432/macrodb
REDIS_URI=redis://redis:6379
REDIS_HOST=redis://redis:6379
LAST_ONLINE_REDIS_URI=redis://redis:6379
DOCUMENT_STORAGE_SERVICE_REDIS_URI=redis://redis:6379
OPENSEARCH_URL=http://search:9200
OPENSEARCH_USERNAME=macrouser
OPENSEARCH_PASSWORD=local
KAFKA_BROKERS=kafka:29092

# Optional only for private GitHub package dependencies used by the lexical
# service image. Leave empty when the packages are public.
GITHUB_PACKAGES_TOKEN=

LOCAL_AWS_URL=http://localstack:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
ATTACHMENT_BUCKET=macro-email-attachments
DOCUMENT_STORAGE_BUCKET=doc-storage
DOCX_DOCUMENT_UPLOAD_BUCKET=docx-upload
STATIC_STORAGE_BUCKET=static-file-storage
UPLOAD_STAGING_BUCKET=bulk-upload-staging
BACKFILL_JOBS_TABLE=search-processing-backfill-jobs
BULK_UPLOAD_REQUESTS_TABLE=bulk-upload
CONNECTION_GATEWAY_TABLE=connection-gateway-table
STATIC_FILE_SERVICE_DYNAMODB_TABLE_NAME=static-file-metadata
DOCUMENT_UPLOAD_FINALIZER_QUEUE_URL=http://localstack:4566/000000000000/document-upload-finalizer-queue

# LocalStack queue overrides. These pin async jobs and integration-adjacent
# workers to local queues instead of any environment defaults baked into code.
OVERRIDE_CHAT_DELETE_QUEUE=delete-chat-handler-queue
OVERRIDE_CONTACTS_QUEUE=contacts-queue
OVERRIDE_CONVERT_QUEUE=convert-service-queue
OVERRIDE_DOCUMENT_DELETE_QUEUE=delete-document-handler-queue
OVERRIDE_DOCUMENT_TEXT_EXTRACTOR_QUEUE=document-text-extractor-lambda-queue
OVERRIDE_EMAIL_SCHEDULED_QUEUE=email-service-scheduled-queue
OVERRIDE_GMAIL_INBOX_SYNC_QUEUE=email-service-gmail-inbox-sync-queue
OVERRIDE_GMAIL_INBOX_SYNC_RETRY_QUEUE=email-service-gmail-inbox-retry-queue
OVERRIDE_GMAIL_OPS_QUEUE=email-service-gmail-ops-queue
OVERRIDE_GMAIL_OPS_RETRY_QUEUE=email-service-gmail-ops-retry-queue
OVERRIDE_LINK_MANAGER_QUEUE=email-service-refresh-queue
OVERRIDE_NOTIFICATION_QUEUE=http://localstack:4566/000000000000/notification-queue
OVERRIDE_NOTIFICATION_INGRESS_QUEUE=http://localstack:4566/000000000000/notification-ingress-queue
OVERRIDE_PUSH_NOTIFICATION_EVENT_HANDLER_QUEUE=push-delivery-queue
OVERRIDE_WEBHOOK_EVENT_QUEUE=http://localstack:4566/000000000000/webhook-event-queue.fifo
OVERRIDE_SEARCH_EVENT_QUEUE=search-event-queue
OVERRIDE_AI_PROJECTION_QUEUE=http://localstack:4566/000000000000/ai-projection-queue
OVERRIDE_SFS_DELETE_QUEUE=email-sfs-delete-queue
OVERRIDE_SFS_UPLOADER_QUEUE=email-service-sfs-mapper-queue
OVERRIDE_STATIC_FILE_SERVICE_S3_EVENT_QUEUE_URL=http://localstack:4566/000000000000/static-file-s3-event-notification-queue
OVERRIDE_EMAIL_BACKFILL_QUEUE=http://localstack:4566/000000000000/email-service-backfill-queue
OVERRIDE_UPLOAD_EXTRACTOR_QUEUE=upload-extractor-queue
OVERRIDE_ORGANIZATION_RETENTION_QUEUE=organization-retention-queue
ENABLE_EMAIL_SCHEDULED_QUEUE=true
ENABLE_GMAIL_OPS_QUEUE=true

# The same local key is shared by the service containers and FusionAuth hooks.
INTERNAL_API_SECRET_KEY=local
INTERNAL_API_KEY=local
INTERNAL_AUTH_KEY=local
AUTHENTICATION_SERVICE_SECRET_KEY=local-auth-service-secret
SYNC_SERVICE_AUTH_KEY=local
DOCUMENT_PERMISSION_JWT=local
DOCUMENT_STORAGE_SERVICE_AUTH_KEY=local-self-host-dss
SERVICE_INTERNAL_AUTH_KEY=local-self-host-dss
URL_SIGNING_HMAC=local-url-signing-hmac

# Compose-internal service URLs. The macro_service_urls crate defaults local
# services to localhost ports, which is correct from the host but wrong inside
# containers unless the stack supplies these local-only overrides.
OVERRIDE_AUTH_SERVICE_URL=http://authentication-service:8080
OVERRIDE_CONNECTION_GATEWAY_URL=http://connection-gateway:8080
OVERRIDE_DOCUMENT_STORAGE_SERVICE_URL=http://document-storage-service:8080
OVERRIDE_EMAIL_SERVICE_URL=http://email-service:8080
